#!/bin/sh
# The kernel's core_pattern pipe handler, run as root for every core dump in
# the job: keep-core DIR EXE PID, with the core on stdin. EXE is %E, the
# executable's path with '!' for '/'. A crash loop stops at ten cores, so it
# cannot fill the runner's disk and hide the failure that started it. A piped
# dump spells out every page a mapping never touched as zeros, so the copy
# turns them back into holes.
# Serialised, so crashes at the same moment can't all pass the count.
exec 9>"$1/.lock"
flock 9
n=$(ls "$1" | grep -c '^core\.')
[ "$n" -lt 10 ] || exit 0
cp --sparse=always /dev/stdin "$1/core.$2.$3"
