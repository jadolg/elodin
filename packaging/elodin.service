[Unit]
Description=elodin filtering DNS forwarder
After=network-online.target
Wants=network-online.target

# Whatever keeps elodin from starting — something else on :53, a certificate it
# cannot read — usually fails the same way on the next attempt too, and the
# defaults never stop it trying: five starts in ten seconds, against a start
# that spends about a second loading lists before it fails plus the two of
# RestartSec, fits three attempts in the window and so retries forever, burning
# a second of CPU each time and reporting "activating" while the machine has no
# resolver. Five attempts spread over five minutes leaves a transient failure
# room to clear and lets a permanent one stop, in `failed`, where `systemctl
# status` and anything watching it will say so.
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/elodin --config /etc/elodin/elodin.yaml
# SIGHUP reloads the configuration and the DoT/DoH certificates in place; see
# "Signals" in docs/install.md for what needs a restart instead.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# Binding :53 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DynamicUser=yes
StateDirectory=elodin
CacheDirectory=elodin
ConfigurationDirectory=elodin

# With its sizes left unset, elodin sizes itself from what this unit may use
# rather than from what the machine has: MemoryMax= lowers server.max_pending,
# the queries it holds in flight, and CPUQuota= lowers the number of event
# loops (listeners.udp.readers). Neither is set by default; both are worth
# having on a machine elodin shares.
# CPUQuota=50%
# MemoryMax=256M

# Every connection elodin holds is a descriptor, and systemd leaves the soft
# limit at 1024 otherwise. Every query in flight may hold an upstream socket as
# well, and server.max_pending derives to thousands on a machine with a few GB,
# so the connection table, the queries in flight, the upstream pools and the
# loops together are past 1024 on most machines - and under strategy: race each
# query may hold a socket per server it races. Past the limit the
# accept loop cannot take a connection at all: it waits between attempts,
# escalating to a second, warns once naming this setting, and counts each wait
# as accept_backoff=. 65536 covers the largest derived figures racing a dozen
# servers (4096 in flight, 4096 race queries per server, 512 connections) and
# leaves room to raise max_connections into the thousands without editing the
# unit; past that, raise this with it. A descriptor limit costs nothing until it
# is used.
LimitNOFILE=65536

# A blocklist refresh builds new rule tables, tens of MB at a few hundred
# thousand rules, and frees the old ones. Each free of a block that large raises
# glibc's mmap threshold to its size, so the next refresh's tables come from the
# heap, which does not give freed memory back: resident memory settles at a
# refresh's peak, about twice what the rules need. A fixed threshold keeps them
# mmap'd and returned on free. Per-query allocations stay below it; a fiber's
# stack and scratch are mapped by elodin itself and given back when an idle
# loop trims them.
# The transport benchmarks stayed within their noise (#513). musl ignores it.
# For glibc's default, put UnsetEnvironment=MALLOC_MMAP_THRESHOLD_ in a drop-in.
Environment=MALLOC_MMAP_THRESHOLD_=131072

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
