[Unit]
Description=elodin filtering DNS forwarder
After=network-online.target
Wants=network-online.target

# Whatever keeps elodin from starting — something else on :53, a certificate it
# cannot read — usually fails the same way on the next attempt too, and the
# defaults never stop it trying: five starts in ten seconds, against a start
# that spends about a second loading lists before it fails plus the two of
# RestartSec, fits three attempts in the window and so retries forever, burning
# a second of CPU each time and reporting "activating" while the machine has no
# resolver. Five attempts spread over five minutes leaves a transient failure
# room to clear and lets a permanent one stop, in `failed`, where `systemctl
# status` and anything watching it will say so.
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/elodin --config /etc/elodin/elodin.yaml
# SIGHUP reloads the DoT/DoH certificates in place; see "Reloading" in the
# README for what that does and does not cover.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# Binding :53 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DynamicUser=yes
StateDirectory=elodin
CacheDirectory=elodin
ConfigurationDirectory=elodin

# With server.workers and server.upstream_workers left unset, elodin sizes its
# thread pools from what this unit may use rather than from what the machine
# has, so a limit named here is also a limit on the threads it raises. Neither
# is set by default; both are worth having on a machine elodin shares.
# CPUQuota=50%
# MemoryMax=256M

# Every connection elodin holds is a descriptor, and systemd leaves the soft
# limit at 1024 otherwise - which the shipped server.max_connections (512) fits
# under and nothing much above 900 does. Past the limit the accept loop cannot
# take a connection at all: it waits a second between attempts, warns once
# naming this setting, and counts each wait as accept_backoff=. 8192 leaves
# room to raise max_connections into the thousands without editing the unit;
# past that, raise this with it.
LimitNOFILE=8192

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
