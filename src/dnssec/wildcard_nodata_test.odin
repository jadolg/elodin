@(private = "file")
wn_query :: proc(ctx: rawptr, name: string, type: dns.Type, allocator: mem.Allocator, _: ^time.Tick) -> (wire: []u8, ok: bool) {
	for f in WN_FIXTURES {
		if f.type == type && dns.name_equal_fold(f.name, name) {
			return decode_hex(f.wire, allocator)
		}
	}
	return nil, false
}

@(private = "file")
wn_validate :: proc(qname: string, type: dns.Type) -> Result {
	anchor, parsed := parse_trust_anchor(WN_ANCHOR, context.temp_allocator)
	if !parsed {
		return {status = .Indeterminate, reason = "the anchor did not parse"}
	}
	anchors := make([]Trust_Anchor, 1, context.temp_allocator)
	anchors[0] = anchor
	v := make_validator(wn_query, nil, Options{anchors = anchors})
	defer destroy_validator(v)
	reply, _ := wn_query(nil, qname, type, context.temp_allocator, nil)
	return validate(v, qname, type, reply, time.unix(FIXTURE_TIME, 0))
}

@(test)
test_a_wildcard_no_data_under_an_opt_out_cover_is_insecure :: proc(t: ^testing.T) {
	// The walk's DS question for `foo.wotest.` lands in the same opt-out span
	// and ends the chain there, so this holds on that alone. The proof's own
	// check is pinned by `test_nsec3_wildcard_no_data_under_an_opt_out_cover_is_not_secure`.
	result := wn_validate("foo.wotest.", .A)
	testing.expectf(t, result.status == .Insecure, "an opt-out next closer cover must not be secure, got %v (%q)", result.status, result.reason)
	free_all(context.temp_allocator)
}

@(test)
test_a_wildcard_delegation_proves_no_data_for_nothing :: proc(t: ^testing.T) {
	result := wn_validate("foo.wntest.", .A)
	testing.expectf(t, result.status == .Bogus, "a wildcard delegation's NSEC is no NODATA proof, got %v (%q)", result.status, result.reason)
	free_all(context.temp_allocator)
}
