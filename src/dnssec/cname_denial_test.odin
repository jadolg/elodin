@(private = "file")
cd_query :: proc(ctx: rawptr, name: string, type: dns.Type, allocator: mem.Allocator, _: ^time.Tick) -> (wire: []u8, ok: bool) {
	// A non-nil context is the one zone whose keys are out of reach.
	if ctx != nil && dns.name_equal_fold(name, (^string)(ctx)^) {
		return nil, false
	}
	return fixture_answer(CD_FIXTURES, name, type, allocator)
}

/*
Validate a fixture, optionally reshaped first: `edit`, when given, rewrites the
decoded message before it is encoded again, as an on-path sender can without
touching a signature.
*/
@(private = "file")
cd_validate :: proc(key: string, unreachable: ^string = nil, edit: proc(msg: ^dns.Message) = nil) -> Result {
	v := make_validator(cd_query, unreachable, Options{anchors = fixture_anchors(CD_ANCHOR)})
	defer destroy_validator(v)
	f := fixture(key, CD_FIXTURES)
	reply := unhex(f.wire)
	if edit != nil {
		msg, derr := dns.decode_message(reply, context.temp_allocator)
		if derr != .None {
			return {status = .Indeterminate, reason = "the fixture did not decode"}
		}
		edit(&msg)
		encoded, _, eerr := dns.encode_message(msg, context.temp_allocator, dns.MAX_MESSAGE)
		if eerr != .None {
			return {status = .Indeterminate, reason = "the edited fixture did not encode"}
		}
		reply = encoded
	}
	return validate(v, f.name, f.type, reply, fixture_now())
}

// One record from the unsigned `cdun.` appended to the answer: no forgery, and
// it drags the answer's verdict to `Insecure` without touching the chain.
@(private = "file")
append_unsigned :: proc(msg: ^dns.Message) {
	answer := make([dynamic]dns.Record, 0, len(msg.answer) + 1, context.temp_allocator)
	append(&answer, ..msg.answer)
	append(&answer, dns.Record{name = "x.cdun.", type = .A, class = .IN, ttl = 300, data = dns.Rdata_A{addr = {192, 0, 2, 1}}})
	msg.answer = answer[:]
}

@(private = "file")
names :: proc(sets: []Authenticated_Set, name: string, type: dns.Type) -> bool {
	_, found := authenticated_rrset(sets, name, type, .IN)
	return found
}

// The denial is proven in the target's zone, so the verdict is Secure and names
// the proof and its SOA, which the prune then keeps.
@(test)
test_a_nodata_after_a_cname_is_proven_at_the_target :: proc(t: ^testing.T) {
	for key in ([]string{"cd_nodata", "cd_two_hops"}) {
		result := cd_validate(key)
		testing.expectf(t, result.status == .Secure, "%s: got %v (%q)", key, result.status, result.reason)
		testing.expectf(t, names(result.authority, "host.cdtgt.", .NSEC), "%s: the NSEC is not named", key)
		testing.expectf(t, names(result.authority, "cdtgt.", .SOA), "%s: the SOA is not named", key)
	}
	free_all(context.temp_allocator)
}

@(test)
test_an_nxdomain_after_a_cname_is_proven_at_the_target :: proc(t: ^testing.T) {
	result := cd_validate("cd_nxdomain")
	testing.expectf(t, result.status == .Secure, "got %v (%q)", result.status, result.reason)
	testing.expect(t, names(result.answer, "gone.cdsrc.", .CNAME), "the CNAME is not named")
	testing.expect(t, names(result.authority, "cdtgt.", .NSEC), "the wildcard's cover is not named")
	testing.expect(t, names(result.authority, "host.cdtgt.", .NSEC), "the name's cover is not named")
	testing.expect(t, names(result.authority, "cdtgt.", .SOA), "the SOA is not named")
	free_all(context.temp_allocator)
}

@(test)
test_an_nsec3_nodata_after_a_cname_is_proven_at_the_target :: proc(t: ^testing.T) {
	result := cd_validate("cd_nsec3_nodata")
	testing.expectf(t, result.status == .Secure, "got %v (%q)", result.status, result.reason)
	testing.expect(t, names(result.authority, "cdn3.", .SOA), "the SOA is not named")
	free_all(context.temp_allocator)
}

// An unsigned target zone is a chain into insecure data: no AD, nothing refused.
@(test)
test_a_denial_after_a_cname_into_an_unsigned_zone_is_insecure :: proc(t: ^testing.T) {
	result := cd_validate("cd_unsigned_target")
	testing.expectf(t, result.status == .Insecure, "got %v (%q)", result.status, result.reason)
	free_all(context.temp_allocator)
}

/*
An unsigned CNAME into a signed zone: the denial is in the signed zone, and RFC
4035 section 5.4 has it proven there however the chain arrived. Unproven, it is
refused; proven, the answer is insecure for the unsigned hop.
*/
@(test)
test_a_denial_after_an_unsigned_cname_is_proven_at_the_signed_target :: proc(t: ^testing.T) {
	unproven := cd_validate("cd_unsigned_hop")
	testing.expectf(t, unproven.status == .Bogus, "unproven: got %v (%q)", unproven.status, unproven.reason)
	proven := cd_validate("cd_unsigned_hop_proven")
	testing.expectf(t, proven.status == .Insecure, "proven: got %v (%q)", proven.status, proven.reason)
	free_all(context.temp_allocator)
}

/*
A denial the target's zone does not back is refused, as the same denial asked
for directly would be. The lifted proof is genuine and verifies against the
source zone, but it speaks for `swap.cdsrc.` - the name asked about, not the
chain's end - and is signed by keys the target's zone does not hold, so it is
read against the wrong keys and proves nothing about the target either way.
*/
@(test)
test_an_unproven_denial_after_a_cname_is_bogus :: proc(t: ^testing.T) {
	for key in ([]string{"cd_no_proof", "cd_type_present", "cd_wrong_zone"}) {
		result := cd_validate(key)
		testing.expectf(t, result.status == .Bogus, "%s: got %v (%q)", key, result.status, result.reason)
	}
	free_all(context.temp_allocator)
}

// A target zone whose keys cannot be fetched is a walk that did not finish, not
// a forgery.
@(test)
test_a_denial_after_a_cname_into_an_unreachable_zone_is_indeterminate :: proc(t: ^testing.T) {
	unreachable := "cdtgt."
	result := cd_validate("cd_nodata", &unreachable)
	testing.expectf(t, result.status == .Indeterminate, "got %v (%q)", result.status, result.reason)
	free_all(context.temp_allocator)
}

/*
A rewritten rcode has to bring the other proof with it. A NODATA's NSEC shows
the target exists, so it proves no name error; a name error's covers show the
target is absent, so they prove no NODATA. Either flip is refused.
*/
@(test)
test_a_flipped_rcode_after_a_cname_is_bogus :: proc(t: ^testing.T) {
	as_nxdomain := cd_validate("cd_nodata", edit = proc(msg: ^dns.Message) {msg.flags.rcode = u8(dns.Rcode.NX_Domain)})
	testing.expectf(t, as_nxdomain.status == .Bogus, "NODATA read as NXDOMAIN: got %v (%q)", as_nxdomain.status, as_nxdomain.reason)
	as_nodata := cd_validate("cd_nxdomain", edit = proc(msg: ^dns.Message) {msg.flags.rcode = u8(dns.Rcode.No_Error)})
	testing.expectf(t, as_nodata.status == .Bogus, "NXDOMAIN read as NODATA: got %v (%q)", as_nodata.status, as_nodata.reason)
	free_all(context.temp_allocator)
}

/*
One unsigned RRset appended to the answer, from a zone that really is unsigned,
drags the message's verdict down to `Insecure` without touching the chain. The
denial at the chain's end is still claimed, and still has to be proven: an
unproven one is refused, and a proven one is merely insecure, the appended
record being the part nothing vouches for.
*/
@(test)
test_an_unsigned_rrset_does_not_buy_past_the_denial_after_a_cname :: proc(t: ^testing.T) {
	for key in ([]string{"cd_no_proof", "cd_type_present", "cd_wrong_zone"}) {
		result := cd_validate(key, edit = append_unsigned)
		testing.expectf(t, result.status == .Bogus, "%s with an unsigned RRset appended: got %v (%q)", key, result.status, result.reason)
	}
	proven := cd_validate("cd_nodata", edit = append_unsigned)
	testing.expectf(t, proven.status == .Insecure, "a proven denial with an unsigned RRset appended: got %v (%q)", proven.status, proven.reason)
	free_all(context.temp_allocator)
}

/*
A genuine wildcard record replayed for a name with records of its own is
refused, and an unsigned RRset appended beside it does not buy it out of the
expansion proof: that proof is not gated on the rest of the answer being
`Secure`, for the same reason the denial at a chain's end is not.
*/
@(test)
test_an_unsigned_rrset_does_not_buy_past_the_wildcard_proof :: proc(t: ^testing.T) {
	plain := cd_validate("cd_wildcard_replay")
	testing.expectf(t, plain.status == .Bogus, "a replayed wildcard: got %v (%q)", plain.status, plain.reason)
	padded := cd_validate("cd_wildcard_replay", edit = append_unsigned)
	testing.expectf(t, padded.status == .Bogus, "a replayed wildcard with an unsigned RRset appended: got %v (%q)", padded.status, padded.reason)
	free_all(context.temp_allocator)
}

/*
A wildcard CNAME in an opt-out zone, whose expanded name sits in an opt-out
span, has an expansion proof that is merely `Insecure` (RFC 5155 section 9.2).
That lowers the verdict the way an unsigned RRset does, and it does not excuse
the denial at the chain's end from its own proof: unproven, it is refused;
proven, the answer stays insecure, for the expansion's reason.

The span reaches the proof through the walk: the DS question for `x.cdoo.`
lands in it, so the expanded name's zone is insecure before any cover is read,
and the reason is the one an unsigned zone gets.
*/
@(test)
test_an_opt_out_wildcard_does_not_buy_past_the_denial_after_a_cname :: proc(t: ^testing.T) {
	unproven := cd_validate("cd_opt_out_wildcard")
	testing.expectf(t, unproven.status == .Bogus, "an unproven denial behind an opt-out wildcard: got %v (%q)", unproven.status, unproven.reason)
	proven := cd_validate("cd_opt_out_wildcard_proven")
	testing.expectf(t, proven.status == .Insecure, "a proven denial behind an opt-out wildcard: got %v (%q)", proven.status, proven.reason)
	testing.expectf(t, proven.reason == "unsigned zone", "the reason is %q", proven.reason)
	free_all(context.temp_allocator)
}
