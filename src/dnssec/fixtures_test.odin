package dnssec

import "elodin:dns"

/*
Real signed DNS traffic, captured from a public resolver and frozen here.

The validator is exercised against genuine chains - root and com signed with
RSA/SHA-256, cloudflare.com and example.com with ECDSA P-256, ed25519.nl with
Ed25519 - plus real NSEC and NSEC3 denial proofs and a real insecure
delegation. Generating these with our own signer instead would let a
canonicalisation bug agree with itself and still pass.

The signatures have fixed validity windows, so the tests pin `now` to
FIXTURE_TIME, which sits inside every one of them.
*/

Fixture :: struct {
	key:   string,
	name:  string,
	type:  dns.Type,
	rcode: int,
	wire:  string,
}

