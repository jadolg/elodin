			"6a47882007ad056364737263000ab001da2b890c9d671f5db371b219248d7f626a4dfe030fe557d0e00a43dc129b4254" +
			"0e7c68cd8685079d5342362015799deb93822ea23c578235c99e150a03056364737263000006000100000e100030026e" +
			"73056364737263000a686f73746d6173746572056364737263000000000100000e100000038400093a800000012c0563" +
			"6473726300002e000100000e10005900060f0100000e107d3b18206a47882007ad0563647372630092bfe263461a7010" +
			"6d1792947ae2d87e66730a3c30d06f12f83476b92c8501e299e3a4812a9a42d29d1dc89907f7d4ae523d38e1618d5187" +
			"3d93b635aeab5705047377617005636473726300002f000100000e1000130374776f0563647372630000060400000000" +
			"03047377617005636473726300002e000100000e100059002f0f0200000e107d3b18206a47882007ad05636473726300" +
			"d341e7ca16c6983223b5b85ee0486dbd826b9dcf0d6a3409755388b80ee38f5fceac3f644dc967c2aad1f1b4bb652b82" +
			"a58f781c1b8a7c5c2ccc903e464e2600",
	},
}

/*
`cd_no_proof` - a signed CNAME and the target's SOA, no NSEC - is served with
one record from the unsigned `cdun.` appended to the answer. The appended
record drags the answer's verdict to insecure without touching the chain, and
the denial must still be proven.
*/
@(private = "file")
CD_PADDED :: "bare.cdsrc."

@(private = "file")
with_unsigned_answer :: proc(wire: []u8) -> ([]u8, bool) {
	msg, err := dns.decode_message(wire, context.temp_allocator)
	if err != .None {
		return nil, false
	}
	answer := make([dynamic]dns.Record, 0, len(msg.answer) + 1, context.temp_allocator)
	append(&answer, ..msg.answer)
	append(&answer, dns.Record{name = "x.cdun.", type = .A, class = .IN, ttl = 300, data = dns.Rdata_A{addr = {192, 0, 2, 1}}})
	msg.answer = answer[:]
	out, _, eerr := dns.encode_message(msg, context.allocator)
	return out, eerr == .None
}

run_dnssec_cname_denial_cases :: proc(r: ^Runner) {
	mock := mock_make("dnssec-cname-denial", next_port(r))
	for f in CD_FIXTURES {
		wire := from_hex(f.response, context.allocator)
		if f.key == "cd_no_proof" {
			padded, padded_ok := with_unsigned_answer(wire)
			if !padded_ok {
				skip_case(r, "dnssec: denial after a cname", "cannot append to the unproven denial")
				mock_stop(mock)
				return
			}
			wire = padded
		}
		mock_reply(mock, f.qname, f.qtype, wire)
	}
	if !mock_start_or_skip(r, mock, "dnssec: denial after a cname") {
		return
	}
	defer mock_stop(mock)

	udp_port := next_port(r)
	config := dnssec_config(udp_port, mock.port, []string{CD_ANCHOR}, log = "{ level: info }", cache = "{ enabled: true }")
	srv, ok := start_server(r, Server_Options{config = config, udp_port = udp_port})
	if !ok {
		return
	}
	defer stop_server(&srv)

	cases := []struct {
		name:      string,
		qname:     string,
		qtype:     dns.Type,
		rcode:     dns.Rcode,
		// The proof's records, with their signatures, that must reach the client.
		authority: int,
	} {
		{"dnssec: a nodata after a cname is validated at the target and keeps its proof", "www.cdsrc.", .AAAA, .No_Error, 4},
		{"dnssec: the cached copy of that nodata keeps AD and its proof", "www.cdsrc.", .AAAA, .No_Error, 4},
		{"dnssec: an nxdomain after a cname is validated at the target and keeps its proof", "gone.cdsrc.", .A, .NX_Domain, 6},
		{"dnssec: a denial after a cname that the target's zone does not sign is refused", "swap.cdsrc.", .AAAA, .Serv_Fail, 0},
		{"dnssec: an unsigned record appended does not excuse an unproven denial after a cname", CD_PADDED, .AAAA, .Serv_Fail, 0},
	}
	for c, i in cases {
		start_case(r, c.name)
		asked := mock_total(mock)
		res := query_udp(udp_port, build_query(c.qname, u16(c.qtype), edns_size = 1232, dnssec_ok = true))
		if i == 1 {
			check(r, mock_total(mock) == asked, "the repeated question went upstream rather than to the cache")
		}
		if check(r, res.ok, "no response") {
			if msg, decoded := decode_reply(r, res.wire); decoded {
				check_eq_int(r, int(dns.rcode_of(msg)), int(c.rcode), "rcode")
				secure := c.rcode != .Serv_Fail
				check(r, msg.flags.ad == secure, "AD is %v", msg.flags.ad)
				check_eq_int(r, len(msg.authority), c.authority, "authority records")
				soa := false
				for rec in msg.authority {
					soa ||= rec.type == .SOA
				}
				check(r, soa == secure, "SOA kept is %v", soa)
			}
		}
		end_case(r)
	}
}
