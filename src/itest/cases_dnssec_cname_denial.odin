package itest

import "elodin:dns"

/*
Issue #186: a CNAME chain that ends in a denial is validated at the target's
zone, and goes out with AD and its proof (RFC 6840 section 5.8).

The mock serves a signed chain - scenario `cname_denial` of
`testdata/gen/sign_fixtures.py`, copied by key, the same bytes
`src/dnssec/cname_denial_test.odin` reads. The CNAME is signed by `cdsrc.`, the
NODATA and NXDOMAIN at its end by `cdtgt.`; the client must see AD with the SOA
and NSEC records kept, fresh and from the cache, and SERVFAIL where the target's
zone does not back the denial.
*/

@(private = "file")
CD_ANCHOR :: ". IN DS 16168 15 2 930FB37FD5EF17869A7FEAC139ED83947BFF427A91A613D9AFDE57174B37B8A7"

