run_dnssec_reverse_cases :: proc(r: ^Runner) {
	upstream_port := next_port(r)
	mock := mock_make("dnssec-reverse", upstream_port)
	for f in R6_FIXTURES {
		mock_reply(mock, f.qname, f.qtype, from_hex(f.response, context.allocator))
	}
	if !mock_start(mock) {
		skip_case(r, "dnssec: ipv6 reverse", "cannot start the mock upstream")
		return
	}
	defer mock_stop(mock)

	udp_port := next_port(r)
	config := fmt.tprintf(
		`listeners:
  udp: {{enabled: true, address: 127.0.0.1, port: %d}}
  tcp: {{enabled: false}}
upstream:
  servers: [udp://127.0.0.1:%d]
cache: {{enabled: false}}
blocking: {{enabled: false}}
dnssec:
  enabled: true
  trust_anchors:
    - %q
`,
		udp_port,
		upstream_port,
		R6_ANCHOR,
	)
	srv, ok := start_server(r, Server_Options{config = config, udp_port = udp_port})
	if !ok {
		return
	}
	defer stop_server(&srv)

	start_case(r, "dnssec: a full-length ipv6 reverse name is validated, not refused")
	{
		res := query_udp(udp_port, build_query(R6_QNAME, u16(dns.Type.PTR), edns_size = 1232, dnssec_ok = true))
		if check(r, res.ok, "no response") {
			h := parse_header(r, res.wire)
			check_eq_int(r, h.rcode, int(dns.Rcode.NX_Domain), "rcode for a signed ipv6 reverse name error")
			// AD is the whole claim: the chain was walked and the denial was
			// checked against the zone's own key. SERVFAIL here is #352, and a
			// NOERROR or an NXDOMAIN without AD would mean the walk was skipped
			// rather than taken.
			check(r, len(res.wire) >= 4 && res.wire[3] & 0x20 != 0, "the answer does not carry the AD bit")
		}
	}
	end_case(r)

	start_case(r, "dnssec: the ipv4 reverse name beside it is unaffected")
	{
		// The counterpart, and the reason this hid for as long as it did: six
		// labels never reached the bound, so in-addr.arpa. answered normally
		// throughout. Nothing signs this one here, so it fails closed - what
		// matters is that both names reach a verdict of their own rather than
		// one being decided by its length.
		res := query_udp(udp_port, build_query("8.8.8.8.in-addr.arpa.", u16(dns.Type.PTR), edns_size = 1232))
		if check(r, res.ok, "no response") {
			h := parse_header(r, res.wire)
			check_eq_int(r, h.rcode, int(dns.Rcode.Serv_Fail), "rcode for an unsigned ipv4 reverse name")
		}
	}
	end_case(r)
}
