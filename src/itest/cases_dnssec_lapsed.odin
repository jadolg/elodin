package itest

import "core:fmt"
import "elodin:dns"

/*
Issue #360: a signature outside its validity window reaches the client as RFC
8914 code 7 (Signature Expired) or 8 (Signature Not Yet Valid), with the instant
in the extra text - not as code 6 and "broken chain of trust", which a forged
zone gets and which sends an operator whose clock is wrong to look at the zone.

The mock serves scenario `lapsed_signatures` of `testdata/gen/sign_fixtures.py`,
copied by key, the same bytes `src/dnssec/lapsed_signature_test.odin` reads. Each
name has one step of its chain signed outside its window and every other step
current. The remembered verdict is asked for a second time, so the cached
refusal is held to the same code.
*/

@(private = "file")
LP_ANCHOR :: ". IN DS 58035 15 2 40943A68A2E3F606BFEEAC456469D9F16E5E088D23C7875041F9E763F9E827E2"

