			"3f5c5881e2634b13e13050bec2f823355728862071ec3c21c7d310999d648ba82909",
	},
}

@(private = "file")
lp_config :: proc(udp_port, upstream_port: int) -> string {
	return fmt.tprintf(
		`listeners:
  udp: {{enabled: true, address: 127.0.0.1, port: %d}}
  tcp: {{enabled: false}}
upstream:
  servers: [udp://127.0.0.1:%d]
blocking: {{enabled: false}}
dnssec:
  enabled: true
  trust_anchors:
    - %q
`,
		udp_port,
		upstream_port,
		LP_ANCHOR,
	)
}

run_dnssec_lapsed_cases :: proc(r: ^Runner) {
	mock := mock_make("dnssec-lapsed", next_port(r))
	for f in LP_FIXTURES {
		mock_reply(mock, f.qname, f.qtype, from_hex(f.response, context.allocator))
	}
	if !mock_start(mock) {
		skip_case(r, "dnssec: a lapsed signature is named by its window", "cannot start the mock upstream")
		return
	}
	defer mock_stop(mock)

	udp_port := next_port(r)
	srv, ok := start_server(r, Server_Options{config = lp_config(udp_port, mock.port), udp_port = udp_port})
	if !ok {
		return
	}
	defer stop_server(&srv)

	EXPIRED :: "signature expired at 2026-07-03T10:00:00Z"
	NOT_YET :: "signature not yet valid until 2046-07-28T10:00:00Z"
	cases := []struct {
		name:  string,
		qname: string,
		rcode: dns.Rcode,
		code:  int,
		text:  string,
	} {
		{"dnssec: a DS signed by its parent past its expiration is code 7", "www.dsx.", .Serv_Fail, 7, EXPIRED},
		{"dnssec: a DNSKEY set signed before its inception is code 8", "www.dkx.", .Serv_Fail, 8, NOT_YET},
		{"dnssec: an answer signed past its expiration is code 7", "late.lt.", .Serv_Fail, 7, EXPIRED},
		{"dnssec: an answer signed before its inception is code 8", "early.lt.", .Serv_Fail, 8, NOT_YET},
		{"dnssec: the cached refusal of that answer is code 8 too", "early.lt.", .Serv_Fail, 8, NOT_YET},
		{"dnssec: an unsigned delegation whose DS denial is not yet valid is code 8", "www.unsigned.lt.", .Serv_Fail, 8, NOT_YET},
		{"dnssec: an expired signature beside a current one still validates", "both.lt.", .No_Error, -1, ""},
		{"dnssec: a current signature that fails beside an expired one is code 6", "mixed.lt.", .Serv_Fail, 6, "no valid signature"},
	}
	for c, i in cases {
		start_case(r, c.name)
		asked := mock_total(mock)
		res := query_udp(udp_port, build_query(c.qname, u16(dns.Type.A), edns_size = 1232, dnssec_ok = true))
		if i == 4 {
			check(r, mock_total(mock) == asked, "the repeated question went upstream rather than to the remembered verdict")
		}
		if check(r, res.ok, "no response") {
			msg, err := dns.decode_message(res.wire, context.allocator)
			if check(r, err == .None, "the answer does not decode") {
				check_eq_int(r, int(dns.rcode_of(msg)), int(c.rcode), "rcode")
				check(r, msg.flags.ad == (c.rcode == .No_Error), "AD is %v", msg.flags.ad)
				code, text := extended_error_with_text(r, res.wire)
				check_eq_int(r, code, c.code, "extended error")
				check(r, text == c.text, "extra text %q, want %q", text, c.text)
			}
		}
		end_case(r)
	}
}
